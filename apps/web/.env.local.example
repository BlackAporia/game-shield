# Copy this file to .env.local and replace the placeholders.
NEXT_PUBLIC_GAMESHIELD_CONTRACT_ADDRESS=0x...
NEXT_PUBLIC_STRK20_POOL_ADDRESS=0x...
NEXT_PUBLIC_STARKNET_RPC_URL=https://rpc.starknet.lava.build

