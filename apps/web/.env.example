# GameShield frontend env (Vercel-friendly)
# Optional: overrides the default public RPC for each network.
# NEXT_PUBLIC_RPC_MAINNET=https://starknet-mainnet.g.alchemy.com/v2/YOUR_KEY
# NEXT_PUBLIC_RPC_SEPOLIA=https://starknet-sepolia.g.alchemy.com/v2/YOUR_KEY

# Deployed on-chain addresses (set after first Deploy contracts run)
# NEXT_PUBLIC_REGISTRY_ADDRESS=0x...
# NEXT_PUBLIC_HELPER_ADDRESS=0x...
