# Public frontend configuration
NEXT_PUBLIC_GAMESHIELD_CONTRACT_ADDRESS=0x...
NEXT_PUBLIC_STRK20_POOL_ADDRESS=0x...
NEXT_PUBLIC_STARKNET_RPC_URL=https://your-starknet-rpc.example/rpc

# Server-only Supabase configuration. Never expose the service-role key to the browser.
SUPABASE_URL=https://your-project.supabase.co/rest/v1/
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key
